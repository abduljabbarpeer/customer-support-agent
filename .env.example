# Settings for the agent.
# Copy this file to a new file called .env, then paste your own key into .env.
# Never paste your key into a Claude Code prompt, and never upload .env anywhere.

# Your free Gemini API key from Google AI Studio (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=paste-your-key-here

# The Gemini model the agent uses. It is set here and nowhere else.
GEMINI_MODEL=gemini-3.5-flash-lite

# Link to the FAQ Google Sheet (the normal link; the Sheet must be shared "anyone with the link can view").
FAQ_SHEET_URL=paste-your-faq-sheet-link-here
